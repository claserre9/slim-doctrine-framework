# Application
APP_ENV=development
APP_DEBUG=1

# Database configuration
# Options: pdo_sqlite, pdo_mysql, pdo_pgsql
# Note: the Docker stack (docker-compose.yml) always uses its Postgres service
DB_DRIVER=pdo_sqlite

# SQLite (used when DB_DRIVER=pdo_sqlite)
# Relative to project root or absolute path
DB_PATH=var/data/database.sqlite

# MySQL (used when DB_DRIVER=pdo_mysql)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=app
# DB_USER=root
# DB_PASSWORD=secret

# PostgreSQL (used when DB_DRIVER=pdo_pgsql)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=app
# DB_USER=postgres
# DB_PASSWORD=secret

# CORS (comma-separated lists)
# CORS_ORIGINS=*
# CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# CORS_HEADERS=Content-Type,Authorization,Accept,Origin,X-Requested-With
# CORS_EXPOSE_HEADERS=
# CORS_CREDENTIALS=0
# CORS_MAX_AGE=600

# Xdebug (Docker dev)
# XDEBUG_MODE controls features: off, develop, debug, profile, trace
XDEBUG_MODE=debug,develop
# Start only when triggered (Cookie/GET/ENV XDEBUG_TRIGGER=1)
XDEBUG_START_WITH_REQUEST=trigger
# PhpStorm/IDE listening host (Docker Desktop supports host.docker.internal)
XDEBUG_CLIENT_HOST=host.docker.internal
# Default Xdebug 3 debug port
XDEBUG_CLIENT_PORT=9003
# Set to 0 for no logs, or 7 for verbose troubleshooting
XDEBUG_LOG_LEVEL=0
# Discover client host via request (useful if host.docker.internal is unavailable)
XDEBUG_DISCOVER_CLIENT_HOST=1
