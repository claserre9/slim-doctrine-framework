# Application
APP_ENV=development
APP_DEBUG=1

# Database configuration
# Options: pdo_sqlite, pdo_mysql, pdo_pgsql
DB_DRIVER=pdo_sqlite

# SQLite (used when DB_DRIVER=pdo_sqlite)
# Relative to project root or absolute path
DB_PATH=var/data/database.sqlite

# MySQL (used when DB_DRIVER=pdo_mysql)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=app
# DB_USER=root
# DB_PASSWORD=secret

# PostgreSQL (used when DB_DRIVER=pdo_pgsql)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=app
# DB_USER=postgres
# DB_PASSWORD=secret
