<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Application">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Error responses are asserted by the tests: keep Slim's error log out of the output -->
        <ini name="error_log" value="/dev/null"/>
        <!-- Each application instance gets its own empty in-memory database -->
        <env name="DB_DRIVER" value="pdo_sqlite" force="true"/>
        <env name="DB_PATH" value=":memory:" force="true"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
