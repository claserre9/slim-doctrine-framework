{
  "require": {
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "symfony/dotenv": "^7.3.0",
    "php-di/php-di": "7.0.11",
    "doctrine/orm": "^3.3",
    "doctrine/dbal": "^4.2",
    "symfony/cache": "^7.3"
  }
,
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "symfony/var-dumper": "^7.3.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {"App\\": "src/"}
  },
  "autoload-dev": {
    "psr-4": {"tests\\": "tests/"}
  },
  "scripts": {
    "test": "phpunit --testdox --configuration phpunit.xml"
  }
}